# GEMINI_API_KEY: Optional for Gemini AI API calls if added later.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SESSION_SECRET: Secret key used to sign session tokens (set a strong random string in production).
SESSION_SECRET=

# INITIAL_ADMIN_PIN: Initial 6-digit numeric PIN used when seeding didi and mario on first run.
INITIAL_ADMIN_PIN=
